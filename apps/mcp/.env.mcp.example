# MCP 三服务部署用变量模板（复制所需键到仓库根目录 .env，docker compose 会自动插值）
# 手册见 docs/agentarts/06-MCP 配置手册.md

# 关系库：云上 MySQL/RDS 地址；或本机 MySQL（宿主机部署时用 host.docker.internal）
MCP_DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/softbei?charset=utf8mb4
# 本机 MySQL 未启动时的 profile/assessment 联调方案（graph 不适用）：
# MCP_DATABASE_URL=sqlite:////data/mcp/mcp.db
MCP_AUTO_INIT_DB=false

# Neo4j：graph-server 强依赖，必须可达
MCP_NEO4J_URI=bolt://host.docker.internal:7687
MCP_NEO4J_USER=neo4j
MCP_NEO4J_PASSWORD=

# 仅当 AgentArts 接入支持自定义 Header 时启用；留空关闭鉴权
MCP_ACCESS_TOKEN=

MCP_LOG_LEVEL=INFO