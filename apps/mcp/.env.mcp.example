# MCP Server 单端口部署变量模板（复制所需键到仓库根目录 .env，docker compose 会自动插值）
# 手册见 docs/agentarts/07-MCP 配置手册.md

# 关系库：云上 MySQL/RDS 地址；或本机 MySQL（宿主机部署时用 host.docker.internal）
MCP_DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/softbei?charset=utf8mb4
# 本机 MySQL 未启动时的 profile/assessment 工具联调方案（graph 工具不适用）：
# MCP_DATABASE_URL=sqlite:////data/mcp/mcp.db
MCP_AUTO_INIT_DB=false

# Neo4j：graph 工具强依赖，必须可达
MCP_NEO4J_URI=bolt://host.docker.internal:7687
MCP_NEO4J_USER=neo4j
MCP_NEO4J_PASSWORD=

# 宿主机映射端口（容器内固定 8080）
MCP_PORT=8080

# 鉴权：独立部署默认 local + token；AgentArts 接入不支持自定义 Header 时留空 token（无鉴权，靠安全组），
# 接入运行时网关时改为 MCP_AUTH_MODE=platform
MCP_AUTH_MODE=local
MCP_ACCESS_TOKEN=

MOCK_LLM=true
MCP_LOG_LEVEL=INFO
