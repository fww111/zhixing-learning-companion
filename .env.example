MOCK_LLM=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
# Intelligent tutoring image understanding uses Qwen3.7-Plus by default.
TUTOR_VISION_API_KEY=
TUTOR_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TUTOR_VISION_MODEL=qwen3.7-plus
DATABASE_URL=mysql+pymysql://root:709055@127.0.0.1:3306/sortbei11?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=100
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
OPENMAIC_BASE_URL=http://127.0.0.1:3000
OPENMAIC_TIMEOUT_SECONDS=30
# AgentArts 平台发布的应用 API（API Key 只存在后端，禁止下发到浏览器）
AGENTARTS_API_KEY=
AGENTARTS_BASE_URL=
AGENTARTS_TIMEOUT_SECONDS=60
# OpenMAIC classroom TTS defaults to Aliyun Bailian Qwen TTS.
TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=
# Optional local VoxCPM2 adapter exposed by this FastAPI backend at /tts/upload.
# Keep it optional; CPU-only/low-memory machines may not run VoxCPM2 reliably.
VOXCPM_MODEL_ID=D:/softbei/a3/data/models/voxcpm/VoxCPM2
VOXCPM_CACHE_DIR=D:/softbei/a3/data/models/voxcpm
VOXCPM_DEVICE=
VOXCPM_LOCAL_FILES_ONLY=true
VOXCPM_LOAD_DENOISER=false
VOXCPM_OPTIMIZE=false
VOXCPM_FALLBACK_TONE=false
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=D:/softbei/a3/data/models/embeddings/BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=D:/softbei/a3/data/models/embeddings
MINERU_ENABLED=false
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=900
MINERU_FALLBACK_TO_LOCAL=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
OCR_LANG=chi_sim+eng
OCR_MODEL_SIZE=mobile
OCR_TEXT_MIN_CHARS=50
OCR_MAX_PAGES=20
OCR_RENDER_SCALE=1.5

# --- MCP Server (AgentArts runtime) ---------------------------------------
# 统一单端口入口：apps/mcp/src/mcp_servers/server.py，端点 POST /mcp + GET /ping
# PORT 优先于 MCP_PORT；AgentArts 运行时控制台填写的端口必须与此一致
PORT=8080
MCP_HOST=0.0.0.0
# all | profile | graph | assessment（all = 17 个工具全部注册到一个端点）
MCP_SERVER=all
# platform：鉴权交给 AgentArts 运行时网关（部署到云端时必须用这个）
# local：本服务自己校验 Authorization: Bearer $MCP_ACCESS_TOKEN（仅本地/ECS 独立部署）
MCP_AUTH_MODE=platform
MCP_ACCESS_TOKEN=
MCP_LOG_LEVEL=INFO
